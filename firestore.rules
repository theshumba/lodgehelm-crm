rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LodgeHelm HQ: no login screen (owner's decision, 21 Oct 2026). The page signs in
    // anonymously, so any signed-in session may read and save. Leads can never be
    // deleted from the browser (the app soft-deletes with a tombstone, which is an
    // update). Call Brain, the CLI and the outreach engine use the service account,
    // which bypasses these rules.
    function signedIn() { return request.auth != null; }
    match /leads/{leadId} {
      allow read, create, update: if signedIn();
    }
    match /inbox/{docId} {
      allow read, delete: if signedIn();
    }
    match /hq/{docId} {
      allow read: if signedIn();
    }
    match /engineStatus/{docId} {
      allow read: if signedIn();
    }
  }
}
